# Variables d'environnement — « Je fais le plein ou non ? »
#
# Copier ce fichier vers `.env` et remplir les valeurs réelles.
# Ne jamais committer `.env` (git-ignoré). Aucun secret côté client.

# --- Modèle OpenCode (obligatoire, cf. AGENTS.md) ---
# Modèle fixe : deepseek/deepseek-v4-flash (API officielle DeepSeek).
# Ne pas basculer sur un autre modèle.
OPENCODE_MODEL=deepseek/deepseek-v4-flash

# --- Clé API OpenCode / DeepSeek ---
# Requise pour utiliser OpenCode avec l'API DeepSeek officielle.
# https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# --- Base URL de l'API DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Application Nuxt ---
# Port HTTP du serveur Nitro (défaut 3000)
NITRO_PORT=3000
# Hôte d'écoute (défaut localhost ; 0.0.0.0 pour Docker)
NITRO_HOST=0.0.0.0

# --- Persistance SQLite ---
# Chemin du fichier SQLite utilisé par Drizzle (volume docker-data/ en Docker)
DATABASE_PATH=./data/app.db

# --- Provider officiel des prix (DGCCRF, option 1 par défaut) ---
# cf. docs/research/fuel-data-source.md et ADR-0003
FUEL_PRICES_PROVIDER=opendatasoft

# --- Job de synchronisation (ticket 008, spec §9.6) ---
# Fréquence en heures entre deux synchronisations complètes (défaut 2 — 2 à 4
# fois/jour, cohérent avec la fréquence observée de la source, recherche §5).
SYNC_INTERVAL_HOURS=2

# --- Base URL de l'API pour le client natif (APK / WebView Capacitor) ---
# Variable d'environnement de build, inline par Vite dans le bundle client.
# En dev et en web SSR, laisser vide : l'API est servie par Nitro lui-même
# (même origin, URL relatives). Renseigner UNIQUEMENT pour le build APK, avec
# l'URL HTTPS publique du backend hébergé (ex. https://api.mondomaine.fr),
# SANS slash final. Ne jamais y mettre de secret (exposé côté client).
NUXT_PUBLIC_API_BASE=
